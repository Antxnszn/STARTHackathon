# Environment Variables for GreenPass Backend
# Copy this file to .env and fill in the values

# ===================
# Database
# ===================
DATABASE_URL=postgresql://greenpass:hackathon_password@localhost:5432/greenpass_db

# ===================
# API Keys (External Services)
# ===================
# Climatiq API Key - Get from https://www.climatiq.io/
CLIMATIQ_API_KEY=your_climatiq_api_key_here

# Global Forest Watch (optional, some endpoints are public)
GFW_API_KEY=

# ===================
# Application Settings
# ===================
DEBUG=true
LOG_LEVEL=INFO

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===================
# Security (Production)
# ===================
# SECRET_KEY=your-super-secret-key-here
# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=60
